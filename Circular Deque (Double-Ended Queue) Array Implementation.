#include <iostream>//Circular Deque (Double-Ended Queue) Array Implementation.
using namespace std;

class Deque {
    int *arr;
    int front;
    int rear;
    int size;

public:
    Deque(int n) {
        size = n;
        arr = new int[n];
        front = -1;
        rear = -1;
    }

    // Helper function to check if deque is full
    bool isFull() {
        return ((front == 0 && rear == size - 1) || ((rear + 1) % size == front));
    }

    // Helper function to check if deque is empty
    bool isEmpty() {
        return (front == -1);
    }

    // Pushes 'X' in the front of the deque. Returns true if it gets pushed.
    bool pushFront(int x) {
        if (isFull()) {
            return false;
        }
        else if (isEmpty()) {
            front = rear = 0;
        }
        else if (front == 0) {
            front = size - 1; // Wrap around to the end
        }
        else {
            front--;
        }
        arr[front] = x;
        return true;
    }

    // Pushes 'X' in the back of the deque. Returns true if it gets pushed.
    bool pushRear(int x) {
        if (isFull()) {
            return false;
        }
        else if (isEmpty()) {
            front = rear = 0;
        }
        else if (rear == size - 1) {
            rear = 0; // Wrap around to the beginning
        }
        else {
            rear++;
        }
        arr[rear] = x;
        return true;
    }

    // Pops an element from the front of the deque. Returns -1 if the deque is empty.
    int popFront() {
        if (isEmpty()) {
            return -1;
        }
        
        int ans = arr[front];
        arr[front] = -1;
        
        if (front == rear) { // Last remaining element popped
            front = rear = -1;
        }
        else if (front == size - 1) {
            front = 0; // Wrap around
        }
        else {
            front++;
        }
        return ans;
    }

    // Pops an element from the back of the deque. Returns -1 if the deque is empty.
    int popRear() {
        if (isEmpty()) {
            return -1;
        }
        
        int ans = arr[rear];
        arr[rear] = -1;
        
        if (front == rear) { // Last remaining element popped
            front = rear = -1;
        }
        else if (rear == 0) {
            rear = size - 1; // Wrap around
        }
        else {
            rear--;
        }
        return ans;
    }

    int getFront() {
        if (isEmpty()) return -1;
        return arr[front];
    }

    int getRear() {
        if (isEmpty()) return -1;
        return arr[rear];
    }
    
    // Destructor to free dynamically allocated memory
    ~Deque() {
        delete[] arr;
    }
};

int main() {
    Deque dq(4);

    cout << "--- Testing Push Operations ---" << endl;
    cout << "Push Rear 10: " << (dq.pushRear(10) ? "Success" : "Failed") << endl;
    cout << "Push Rear 20: " << (dq.pushRear(20) ? "Success" : "Failed") << endl;
    cout << "Push Front 5: " << (dq.pushFront(5) ? "Success" : "Failed") << endl;

    cout << "\n--- Checking Front and Rear values ---" << endl;
    cout << "Front element: " << dq.getFront() << endl; 
    cout << "Rear element: " << dq.getRear() << endl;

    cout << "\n--- Testing Pop Operations ---" << endl;
    cout << "Popped Rear: " << dq.popRear() << endl;   
    cout << "Popped Front: " << dq.popFront() << endl; 

    cout << "\n--- Checking Final State ---" << endl;
    cout << "New Front: " << dq.getFront() << endl;    
    
    return 0;
}
